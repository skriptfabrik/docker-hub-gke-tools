{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    ":gitSignOff",
    ":semanticCommits",
    ":semanticPrefixChore",
    ":semanticCommitScopeDisabled"
  ],
  "labels": ["dependencies"],
  "timezone": "Europe/Berlin",
  "enabledManagers": [
    "dockerfile",
    "github-actions"
  ],
  "packageRules": [
    {
      "matchManagers": ["dockerfile"],
      "addLabels": ["docker"],
      "schedule": ["* * * * 2"]
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["github_actions"],
      "schedule": ["* * * * 0"]
    }
  ]
}
